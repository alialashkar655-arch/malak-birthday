<?xml version="1.0" encoding="UTF-8"?>
<svg width="800" height="600" viewBox="0 0 800 600" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f8f5fc" />
      <stop offset="100%" stop-color="#ece3f8" />
    </linearGradient>
    <pattern id="scrapbook-dots" width="20" height="20" patternUnits="userSpaceOnUse">
      <circle cx="2" cy="2" r="1" fill="#cebfe8" opacity="0.3"/>
    </pattern>
  </defs>

  <!-- Background -->
  <rect width="100%" height="100%" fill="url(#bg)"/>
  <rect width="100%" height="100%" fill="url(#scrapbook-dots)"/>

  <!-- Inner Polaroid / Card Border -->
  <rect x="20" y="20" width="760" height="560" rx="12" fill="none" stroke="#cebfe8" stroke-width="2" stroke-dasharray="6,6" opacity="0.8"/>

  <!-- Icon Container -->
  <g transform="translate(364, 220) scale(3)">
    <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" fill="none" stroke="#9b7ebb" stroke-width="2"/><circle cx="12" cy="13" r="4" fill="none" stroke="#9b7ebb" stroke-width="2"/>
  </g>

  <!-- Title -->
  <text x="400" y="350" font-family="'Playfair Display', Georgia, serif" font-size="24" font-weight="bold" fill="#5d4182" text-anchor="middle">
    Late Night Conversations
  </text>

  <!-- Subtitle -->
  <text x="400" y="385" font-family="'Plus Jakarta Sans', sans-serif" font-size="14" fill="#8365ab" text-anchor="middle">
    Sweet memories of talking until dawn
  </text>

  <!-- Little hint badge -->
  <rect x="270" y="415" width="260" height="28" rx="14" fill="#cebfe8" opacity="0.35"/>
  <text x="400" y="434" font-family="'Caveat', cursive" font-size="16" fill="#5d4182" text-anchor="middle">
    ✨ Replace with your photo in Admin Panel
  </text>
</svg>