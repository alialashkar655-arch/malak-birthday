<?xml version="1.0" encoding="UTF-8"?>
<svg width="800" height="600" viewBox="0 0 800 600" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#faeaed" />
      <stop offset="100%" stop-color="#f2ccd3" />
    </linearGradient>
    <pattern id="scrapbook-dots" width="20" height="20" patternUnits="userSpaceOnUse">
      <circle cx="2" cy="2" r="1" fill="#d98b9a" opacity="0.3"/>
    </pattern>
  </defs>

  <!-- Background -->
  <rect width="100%" height="100%" fill="url(#bg)"/>
  <rect width="100%" height="100%" fill="url(#scrapbook-dots)"/>

  <!-- Inner Polaroid / Card Border -->
  <rect x="20" y="20" width="760" height="560" rx="12" fill="none" stroke="#d98b9a" stroke-width="2" stroke-dasharray="6,6" opacity="0.8"/>

  <!-- Icon Container -->
  <g transform="translate(364, 220) scale(3)">
    <circle cx="12" cy="12" r="7" fill="none" stroke="#a63248" stroke-width="2"/><path d="M3 6v6a2 2 0 0 0 2 2h0v6M19 6v14M21 6h-4v4a2 2 0 0 0 2 2v8" stroke="#a63248" stroke-width="1.5"/>
  </g>

  <!-- Title -->
  <text x="400" y="350" font-family="'Playfair Display', Georgia, serif" font-size="24" font-weight="bold" fill="#550d1a" text-anchor="middle">
    Romantic Restaurant Dinner 🍝
  </text>

  <!-- Subtitle -->
  <text x="400" y="385" font-family="'Plus Jakarta Sans', sans-serif" font-size="14" fill="#822436" text-anchor="middle">
    Warm candlelight, pasta & good drinks
  </text>

  <!-- Little hint badge -->
  <rect x="270" y="415" width="260" height="28" rx="14" fill="#d98b9a" opacity="0.35"/>
  <text x="400" y="434" font-family="'Caveat', cursive" font-size="16" fill="#550d1a" text-anchor="middle">
    ✨ Replace with your photo in Admin Panel
  </text>
</svg>